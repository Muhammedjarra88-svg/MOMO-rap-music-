<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Momo Rap - Official Player</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="app-container">
        <header class="header">
            <h1>Momo Rap</h1>
            <p class="subtitle">Official Music Space</p>
        </header>

        <div class="player-card">
            <div class="album-art">
                <i class="fa-solid fa-compact-disc spinning-icon"></i>
            </div>
            <div class="track-info">
                <h2 id="current-title">Seleziona un brano</h2>
                <p id="current-artist">Momo Rap</p>
            </div>

            <audio id="audio-player"></audio>

            <div class="progress-container" id="progress-container">
                <div class="progress-bar" id="progress-bar"></div>
            </div>
            
            <div class="time-stamps">
                <span id="current-time">00:00</span>
                <span id="duration">00:00</span>
            </div>

            <div class="controls">
                <button id="prev-btn" class="control-btn"><i class="fa-solid fa-backward-step"></i></button>
                <button id="play-btn" class="control-btn play-main"><i class="fa-solid fa-play"></i></button>
                <button id="next-btn" class="control-btn"><i class="fa-solid fa-forward-step"></i></button>
            </div>
        </div>

        <div class="playlist-section">
            <h3>I tuoi Brani</h3>
            <ul class="playlist" id="playlist">
                <li class="playlist-item" data-src="deserto-nero.mp3" data-title="Deserto Nero" data-artist="Momo Rap">
                    <div class="song-icon"><i class="fa-solid fa-music"></i></div>
                    <div class="song-details">
                        <span class="song-name">Deserto Nero</span>
                        <span class="song-author">Momo Rap</span>
                    </div>
                    <i class="fa-solid fa-play play-indicator"></i>
                </li>
                <li class="playlist-item" data-src="tempeste.mp3" data-title="Le Tempeste Interne" data-artist="Momo Rap">
                    <div class="song-icon"><i class="fa-solid fa-music"></i></div>
                    <div class="song-details">
                        <span class="song-name">Le Tempeste Interne</span>
                        <span class="song-author">Momo Rap</span>
                    </div>
                    <i class="fa-solid fa-play play-indicator"></i>
                </li>
            </ul>
        </div>
    </div>

    <script src="main.js"></script>
</body>
</html>
